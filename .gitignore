.venv/
__pycache__/
*.pyc
.pytest_cache/
.env
fcmenu.sqlite3
*.mdb
*.ldb
migration/pdf_output/

# Datos reales exportados de fcmenu.mdb para cargar a Postgres (clientes,
# facturas, deuda, CUITs reales de ALESTEL SRL y sus clientes) — mismo
# criterio que *.mdb: es DATA, no código. Hallazgo real 2026-08-20: estos
# CSV estaban trackeados desde el commit inicial pese a que el .gitignore
# ya excluía *.mdb — mismos datos reales, sólo en otro formato. El repo
# se puso privado como mitigación inmediata; esto evita que se repita
# hacia adelante.
migration/etl/data/*.csv

# Certificados/claves reales de AFIP (ALESTEL.crt/.key, Homo.key,
# empresa.crt/.csr) — NUNCA al repo, son credenciales reales de la
# empresa, no artefactos de migración.
*.key
*.crt
*.csr
*.pfx
*.p12

# Config local de Claude Code (modo de permisos, etc.) — preferencia
# personal de esta máquina, no algo para compartir en el repo.
.claude/

# Cache local del Ticket de Acceso (TA) de WSAA — AFIP rechaza un login
# nuevo mientras el TA anterior siga vigente (~12hs), ver
# AfipWSFEv1Cliente._archivo_cache_ta(). Contiene un token/sign reales
# de sesión, no una credencial permanente, pero tampoco va al repo.
.afip_cache/

# Salida de PyInstaller (ver packaging/migrar_fcmenu.spec) — binarios
# generados, no código; se reconstruyen con
# `pyinstaller packaging/migrar_fcmenu.spec` (ver doc de la PC nueva).
build/
dist/
