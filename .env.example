# Copiar a .env (no versionado) o setear como variable de entorno real.
# Base de desarrollo local creada en esta sesión (PostgreSQL 18, servicio
# Windows postgresql-x64-18, rol dedicado fcmenu_app, no el superusuario postgres):
DATABASE_URL=postgresql+psycopg2://fcmenu_app:CAMBIAR_ESTA_CONTRASENA@localhost:5432/fcmenu_dev

# Entorno de facturación electrónica (ver migration/afip.py: entorno_afip()).
# Reemplaza al parámetro de línea de comandos /TF: del legacy (FCMENU.bas).
# Valores: STUB (default si no está seteada — sin conexión real a AFIP, CAE
# falso, ver AfipWSFEv1Stub), HOMOLOGACION (servidores de prueba reales de
# AFIP) o PRODUCCION. El cartel de MainMenuWindow muestra "Homologación /
# Prueba" para STUB y HOMOLOGACION, y "PRODUCCIÓN" sólo para este último valor.
FCMENU_AFIP_ENTORNO=STUB
